# Build-time only (read by vite.config.ts). Set in the Vercel project env, or
# copy to .env.local for a local build. Never put secrets in VITE_ vars: they
# end up in the public HTML.

# Google Search Console "HTML tag" token (the content="..." value only).
VITE_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools msvalidate.01 token (the content="..." value only).
VITE_BING_SITE_VERIFICATION=
