{
  "redirects": [
    {
      "source": "/eventos/:slug",
      "destination": "https://www.laexponencial.com/eventos/:slug",
      "statusCode": 301
    },
    {
      "source": "/eventos",
      "destination": "https://www.laexponencial.com/eventos",
      "statusCode": 301
    },
    {
      "source": "/exponencial",
      "destination": "https://www.laexponencial.com/",
      "statusCode": 301
    },
    {
      "source": "/construye",
      "destination": "https://www.laexponencial.com/lanzadera",
      "statusCode": 301
    },
    {
      "source": "/disena-tu-oferta",
      "destination": "https://www.laexponencial.com/disena-tu-curso",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/oferta-privada-construye", "destination": "/__retired" },
    { "source": "/redes-que-venden", "destination": "/__retired" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
