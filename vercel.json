{
  "redirects": [
    {
      "source": "/eventos/:slug",
      "destination": "https://www.laexponencial.com/eventos/:slug",
      "statusCode": 301
    },
    {
      "source": "/eventos",
      "destination": "https://www.laexponencial.com/eventos",
      "statusCode": 301
    },
    {
      "source": "/exponencial",
      "destination": "https://www.laexponencial.com/",
      "statusCode": 301
    },
    {
      "source": "/construye",
      "destination": "https://www.laexponencial.com/",
      "statusCode": 301
    },
    {
      "source": "/disena-tu-oferta",
      "destination": "https://www.laexponencial.com/disena-tu-programa",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/legal", "destination": "/index.html" },
    { "source": "/privacy-policy", "destination": "/index.html" },
    { "source": "/terms-of-service", "destination": "/index.html" },
    { "source": "/cookie-policy", "destination": "/index.html" },
    { "source": "/links", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
