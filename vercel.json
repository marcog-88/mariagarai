{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/eventos/:slug",
      "destination": "https://www.laexponencial.com/eventos/:slug",
      "statusCode": 301
    },
    {
      "source": "/eventos",
      "destination": "https://www.laexponencial.com/eventos",
      "statusCode": 301
    },
    {
      "source": "/exponencial",
      "destination": "https://www.laexponencial.com/",
      "statusCode": 301
    },
    {
      "source": "/construye",
      "destination": "https://www.laexponencial.com/",
      "statusCode": 301
    },
    {
      "source": "/disena-tu-oferta",
      "destination": "https://www.laexponencial.com/disena-tu-programa",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
